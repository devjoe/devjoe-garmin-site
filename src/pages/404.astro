---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Page not found — devjoe Garmin" description="The requested page could not be found.">
  <div class="page-shell">
    <header class="page-intro">
      <p class="eyebrow">404</p>
      <h1>That point is beyond the horizon.</h1>
      <p class="lede">The page may have moved, or the address may be incomplete.</p>
      <div class="action-row"><a class="button primary" href="/">Return home</a></div>
    </header>
  </div>
</SiteLayout>
