---
import SiteLayout from "../../layouts/SiteLayout.astro";
import release from "../../data/release.json";

const gallery = [
  {
    src: "/images/burnished-sky-ahead/02-day-night.png",
    label: "Day & night",
    copy: "Coordinated materials shift with the sky while the hierarchy stays familiar.",
  },
  {
    src: "/images/burnished-sky-ahead/03-forecast-ahead.png",
    label: "Forecast ahead",
    copy: "Three actual clock hours make the precipitation or temperature timeline readable at a glance.",
  },
  {
    src: "/images/burnished-sky-ahead/04-always-on-display.png",
    label: "Always-on display",
    copy: "Five restrained ornaments share a purpose-built low-power composition.",
  },
  {
    src: "/images/burnished-sky-ahead/05-weather-frames.png",
    label: "Weather frames",
    copy: "Faceted Seal, Simple Circle, or no frame—each keeps weather legible and composed.",
  },
];
---

<SiteLayout
  title="Burnished Sky Ahead — Garmin watch face by devjoe"
  description={release.product.openingSentence}
  current="product"
>
  <div class="page-shell">
    <section class="product-hero">
      <div class="hero-copy product-hero-copy">
        <p class="eyebrow">Garmin watch face · {release.product.version} Production</p>
        <h1>Burnished<br />Sky Ahead</h1>
        <p>
          Made first for my own Soft Gold Titanium and French Gray Forerunner 970:
          refined, readable, and genuinely useful for the hours ahead.
        </p>
        <div class="action-row">
          <a class="button primary" href="/burnished-sky-ahead/devices/">View supported devices</a>
          <a class="button" href="/burnished-sky-ahead/support/">Get support</a>
          <a class="button" href={release.urls.store}>View on Connect IQ</a>
        </div>
      </div>
      <figure class="product-hero-art">
        <img
          src="/images/burnished-sky-ahead/hero-1440x720.png"
          alt="Burnished Sky Ahead active watch face shown on a Soft Gold Titanium and French Gray Garmin watch"
          width="1440"
          height="720"
          fetchpriority="high"
        />
        <figcaption>Designed as one composition—from AMOLED black to the physical brass-toned bezel.</figcaption>
      </figure>
    </section>

    <section class="section product-statement">
      <div class="section-heading">
        <p class="eyebrow">A miniature instrument</p>
        <h2>Clarity first.<br />Character close behind.</h2>
        <p>
          Time remains unmistakable. Weather and activity form a restrained
          hierarchy around it, with warm brass, mineral gray, and moonlit violet
          details coordinated across day, night, and always-on states.
        </p>
      </div>
      <img
        class="statement-image"
        src="/images/burnished-sky-ahead/01-essentials-at-a-glance.png"
        alt="Burnished Sky Ahead composition showing time, activity, date, current weather, and forecast"
        width="900"
        height="900"
        loading="lazy"
      />
    </section>

    <section class="section visual-story" aria-labelledby="visual-story-title">
      <div class="section-heading">
        <p class="eyebrow">One face, several useful tempos</p>
        <h2 id="visual-story-title">Weather with context.</h2>
        <p>
          The active face, forecast miniature, AOD, and frame options share one
          visual language instead of behaving like unrelated widgets.
        </p>
      </div>
      <div class="visual-grid">
        {gallery.map((item, index) => (
          <article class="visual-card">
            <img src={item.src} alt={`${item.label} visual for Burnished Sky Ahead`} width="900" height="900" loading="lazy" />
            <div class="visual-card-copy">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{item.label}</h3>
                <p>{item.copy}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section content-grid">
      <aside>What it shows</aside>
      <div class="prose">
        <h2>Useful density, composed.</h2>
        <ul>
          <li>Prominent digital time, date, and English weekday.</li>
          <li>Battery, cached heart rate, calories, and daily steps.</li>
          <li>Current Garmin weather, temperature, and a concise condition caption.</li>
          <li>A contextual three-node RAIN, SNOW, MIX, or TEMP forecast.</li>
          <li>A purpose-built AMOLED always-on display.</li>
        </ul>
        <div class="callout">
          <p><strong>Missing stays missing.</strong> Unavailable values display as <code>--</code> or <code>WEATHER</code> rather than guessed data.</p>
        </div>

        <h2>The shortest useful horizon.</h2>
        <p>
          The forecast miniature chooses RAIN, SNOW, or MIX at a meaningful 3H,
          6H, or 9H horizon. When no meaningful precipitation appears within nine
          hours, it shows actual forecast temperatures through TEMP 6H. Each node
          is labeled with its represented local clock hour, so the timeline can be
          read without decoding a relative offset.
        </p>

        <h2>Personal, not configurable chaos.</h2>
        <p>
          Production defaults are Quoted Time, Faceted Seal, and wake animation
          On. Every option stays within the same information architecture, so a
          visual preference never compromises the meaning of the dial.
        </p>

        <h2>Free for everyone.</h2>
        <p>
          Every download and Store review helps the project grow. Optional Tips
          let me spend more time designing, implementing, and testing features
          that are released as free updates for the whole community. Tips can
          accelerate development; they never create private or exclusive features.
        </p>
        <div class="action-row">
          <a class="button primary" href={release.support.url}>Support on Ko-fi</a>
          <a class="button" href="/burnished-sky-ahead/roadmap/">View the public roadmap</a>
          <a class="button" href="/burnished-sky-ahead/privacy/">Read the privacy notice</a>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>
