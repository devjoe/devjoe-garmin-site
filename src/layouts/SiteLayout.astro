---
import "@fontsource-variable/bodoni-moda";
import "@fontsource-variable/source-sans-3";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  current?: string;
  socialImage?: string;
  lang?: string;
  showGarminDisclaimer?: boolean;
}

const {
  title,
  description,
  current = "",
  socialImage = "/images/burnished-sky-ahead/hero-1440x720.png",
  lang = "en",
  showGarminDisclaimer = true,
} = Astro.props;
const isTraditionalChinese = lang === "zh-Hant-TW";
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL(socialImage, Astro.site);
const navigation = [
  { href: "/burnished-sky-ahead/", label: isTraditionalChinese ? "錶面（EN）" : "Sky Ahead", id: "product" },
  { href: "/burnished-sky-ahead/devices/", label: isTraditionalChinese ? "裝置（EN）" : "Devices", id: "devices" },
  { href: "/burnished-sky-ahead/roadmap/", label: isTraditionalChinese ? "更新規劃（EN）" : "Roadmap", id: "roadmap" },
  { href: isTraditionalChinese ? "/zh-tw/burnished-sky-ahead/support/" : "/burnished-sky-ahead/support/", label: isTraditionalChinese ? "台灣支持" : "Support", id: "support" },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#12100e" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="devjoe Garmin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1440" />
    <meta property="og:image:height" content="720" />
    <meta property="og:image:alt" content="Burnished Sky Ahead watch face on a Soft Gold Titanium and French Gray Garmin watch" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="maker" href="/" aria-label={isTraditionalChinese ? "devjoe Garmin 首頁" : "devjoe Garmin home"}>
        <span class="maker-mark" aria-hidden="true">d</span>
        <span>devjoe <em>Garmin</em></span>
      </a>
      <nav aria-label="Primary navigation">
        {navigation.map((item) => (
          <a href={item.href} aria-current={current === item.id ? "page" : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div>
        <p class="eyebrow">{isTraditionalChinese ? "獨立開發" : "Independent by design"}</p>
        <p>{isTraditionalChinese ? "由 devjoe 獨立製作的 Garmin 軟體。" : "Thoughtful Garmin software by devjoe."}</p>
      </div>
      <div class="footer-links">
        <a href="/burnished-sky-ahead/privacy/">{isTraditionalChinese ? "隱私權（EN）" : "Privacy"}</a>
        <a href="/known-issues/">{isTraditionalChinese ? "已知問題（EN）" : "Known issues"}</a>
        <a href="/changelog/">{isTraditionalChinese ? "更新紀錄（EN）" : "Changelog"}</a>
        <a href="mailto:support@devjoe.app">support@devjoe.app</a>
      </div>
      {showGarminDisclaimer && (
        <p class="fine-print">
          {isTraditionalChinese
            ? "本產品由獨立開發者提供，與 Garmin 無隸屬、背書或贊助關係。Garmin 和 Connect IQ 是其各自所有人的商標。"
            : "Independent developer products. Garmin and Connect IQ are trademarks of their respective owner. Not affiliated with or endorsed by Garmin."}
        </p>
      )}
    </footer>
  </body>
</html>
