---
import SiteLayout from "../layouts/SiteLayout.astro";
import listing from "../data/store-listing.json";
---

<SiteLayout
  title="devjoe Garmin — Thoughtful software for the wrist"
  description="Independent Garmin apps by devjoe, designed with clarity, restraint, and care."
>
  <div class="page-shell">
    <section class="hero home-release">
      <div class="hero-copy">
        <p class="eyebrow">Independent Garmin software</p>
        <h1>Time first,<br />Weather ahead,<br />at a glance.</h1>
        <p>
          A clean face, with room for what matters to you.
        </p>
        <div class="action-row">
          <a class="button primary" href="/burnished-sky-ahead/">Discover Burnished Sky Ahead</a>
          <a class="button" href="/burnished-sky-ahead/support/">Product support</a>
        </div>
      </div>
      <a class="home-product-card" href="/burnished-sky-ahead/" aria-label="Discover Burnished Sky Ahead">
        <img
          src="/images/burnished-sky-ahead/1.11.0/hero.gif"
          alt="Burnished Sky Ahead watch-face composition"
          width="1440"
          height="720"
          fetchpriority="high"
        />
        <span><strong>Burnished Sky Ahead</strong><small>All features are free.</small></span>
      </a>
    </section>
    <section class="section">
      <div class="section-heading">
        <p class="eyebrow">Production {listing.version}</p>
        <h2>Burnished Sky Ahead</h2>
        <p>
          Time, weather, and the things that matter to you. Made for supported AMOLED and MIP watches.
        </p>
      </div>
      <div class="feature-grid">
        <article class="feature">
          <span class="feature-index">01</span>
          <h3>Weather with context</h3>
          <p>A forecast that automatically switches between temperature and precipitation chance.</p>
        </article>
        <article class="feature">
          <span class="feature-index">02</span>
          <h3>Room for what matters</h3>
          <p>Countdown, Days since, Analog and Digital second time zones. Choose separately for day and night.</p>
        </article>
        <article class="feature">
          <span class="feature-index">03</span>
          <h3>Your data fields</h3>
          <p>Two customizable data fields, with 11 choices.</p>
        </article>
      </div>
    </section>
  </div>
</SiteLayout>
