---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import release from "../../../data/release.json";
---

<SiteLayout
  title="台灣支持 — Burnished Sky Ahead"
  description="Burnished Sky Ahead 是免費的 Garmin Connect IQ 錶面。台灣使用者可在此了解自願支持方式與建議金額。"
  current="support"
  lang="zh-Hant-TW"
  showGarminDisclaimer={false}
>
  <div class="page-shell">
    <section class="taiwan-support-hero" aria-labelledby="taiwan-support-title">
      <div class="taiwan-support-copy">
        <p class="eyebrow">Burnished Sky Ahead · 台灣支持</p>
        <h1 id="taiwan-support-title">支持<br />Burnished Sky Ahead</h1>
        <p class="taiwan-support-lede">
          Burnished Sky Ahead 是免費的 Garmin Connect IQ 錶面。若它對你有幫助，歡迎自願支持開發、裝置測試與維護。
        </p>

        <section class="taiwan-support-pricing" aria-labelledby="support-amount-title">
          <h2 id="support-amount-title">建議支持金額</h2>
          <div class="taiwan-support-amounts">
            <div class="taiwan-support-amount recommended">
              <span>建議支持</span>
              <strong>NT$149</strong>
            </div>
            <div class="taiwan-support-amount">
              <span>多支持一些</span>
              <strong>NT$249</strong>
            </div>
            <div class="taiwan-support-amount">
              <span>自訂金額</span>
              <strong>自訂</strong>
            </div>
          </div>
          <p class="amount-note">金額為自願支持建議，並非產品售價。</p>
        </section>

        <div class="taiwan-payment-status" role="status">
          <p class="eyebrow">台灣付款方式</p>
          <p><strong>綠界付款入口尚未開放。</strong>核准並完成設定後，會在此加入正式付款連結。</p>
        </div>

        <div class="action-row">
          <a class="button primary" href={release.urls.connectIqStore}>前往 Garmin Connect IQ 免費下載</a>
          <a class="button" href={`mailto:${release.urls.supportEmail}`}>聯絡支援</a>
        </div>
        <p class="taiwan-language-link"><a href="/burnished-sky-ahead/support/">English support page</a></p>
      </div>

      <figure class="taiwan-support-art">
        <img
          src="/images/burnished-sky-ahead/hero-1440x720.png"
          alt="Burnished Sky Ahead 顯示時間與天氣資訊的 Garmin 錶面"
          width="1440"
          height="720"
          fetchpriority="high"
        />
        <figcaption>Burnished Sky Ahead：時間、天氣與未來數小時預報。</figcaption>
      </figure>
    </section>

    <section class="content-grid" aria-labelledby="support-terms-title">
      <aside>支持說明</aside>
      <div class="prose">
        <h2 id="support-terms-title">支持須知</h2>
        <p>
          所有現有功能免費。支持不會解鎖功能、內容、會員或服務，也不代表未來功能或交付時間的承諾。
        </p>

        <h2>付款問題</h2>
        <p>
          請來信 <a href={"mailto:" + release.urls.supportEmail}>{release.urls.supportEmail}</a>。
        </p>

        <div class="action-row">
          <a class="button" href={release.support.url}>海外支持：Ko-fi</a>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .taiwan-support-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    align-items: center;
    gap: clamp(36px, 7vw, 96px);
    padding-block: clamp(66px, 9vw, 122px);
  }

  .taiwan-support-copy h1 {
    font-size: clamp(3.35rem, 6.4vw, 6.6rem);
  }

  .taiwan-support-lede {
    max-width: 620px;
    margin: 28px 0 0;
    color: var(--ink-soft);
    font-size: clamp(1.08rem, 1.7vw, 1.3rem);
  }

  .taiwan-support-pricing {
    margin-top: 34px;
  }

  .taiwan-support-pricing h2 {
    font-size: clamp(1.7rem, 2.7vw, 2.3rem);
  }

  .taiwan-support-amounts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin-top: 16px;
  }

  .taiwan-support-amount {
    min-width: 0;
    padding: 15px 14px;
    border: 1px solid var(--line);
    background: var(--ground-raised);
  }

  .taiwan-support-amount.recommended {
    border-color: var(--brass);
    background: linear-gradient(145deg, rgba(209, 166, 93, 0.09), var(--ground-raised) 72%);
  }

  .taiwan-support-amount span,
  .taiwan-support-amount strong {
    display: block;
  }

  .taiwan-support-amount span {
    color: var(--ink-faint);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .taiwan-support-amount strong {
    margin-top: 7px;
    color: var(--ink);
    font-size: clamp(1rem, 1.5vw, 1.22rem);
    white-space: nowrap;
  }

  .amount-note {
    margin: 12px 0 0;
    color: var(--ink-faint);
    font-size: 0.88rem;
  }

  .taiwan-payment-status {
    margin-top: 22px;
    padding: 18px 20px;
    border-left: 2px solid var(--brass);
    background: var(--ground-raised);
  }

  .taiwan-payment-status .eyebrow {
    margin-bottom: 6px;
  }

  .taiwan-payment-status p:last-child {
    margin: 0;
    color: var(--ink-soft);
  }

  .taiwan-payment-status strong {
    color: var(--ink);
  }

  .taiwan-language-link {
    margin-top: 20px;
    color: var(--ink-faint);
    font-size: 0.9rem;
  }

  .taiwan-support-art {
    position: relative;
    margin: 0;
  }

  .taiwan-support-art::before {
    position: absolute;
    inset: 8% 4% -4% 12%;
    z-index: -1;
    content: "";
    border: 1px solid rgba(209, 166, 93, 0.22);
    background: linear-gradient(135deg, rgba(209, 166, 93, 0.07), rgba(168, 154, 196, 0.045));
    transform: translate(18px, 18px);
  }

  .taiwan-support-art img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(244, 239, 229, 0.14);
    box-shadow: 0 36px 90px rgba(0, 0, 0, 0.38);
  }

  .taiwan-support-art figcaption {
    margin-top: 14px;
    color: var(--ink-faint);
    font-size: 0.82rem;
  }

  @media (max-width: 820px) {
    .taiwan-support-hero {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    .taiwan-support-art {
      width: min(100%, 700px);
    }
  }

  @media (max-width: 540px) {
    .taiwan-support-hero {
      padding-top: 58px;
    }

    .taiwan-support-copy h1 {
      font-size: clamp(3.15rem, 15vw, 4.5rem);
    }

    .taiwan-support-amounts {
      gap: 7px;
    }

    .taiwan-support-amount {
      padding: 13px 10px;
    }

    .taiwan-support-amount span {
      font-size: 0.76rem;
    }

    .taiwan-support-amount strong {
      font-size: 0.96rem;
    }

    .taiwan-support-art::before {
      inset: 5% 2% -3% 8%;
      transform: translate(10px, 10px);
    }
  }
</style>
