---
import SiteLayout from "../../layouts/SiteLayout.astro";
import release from "../../data/release.json";
import listing from "../../data/store-listing.json";
const body = listing.description.split("\n").filter(Boolean).slice(5);
const supportIndex = body.indexOf("Support and FAQ:");
const paragraphs = body.slice(0, supportIndex);
---
<SiteLayout title="Burnished Sky Ahead — Garmin watch face by devjoe" description="Time first, Weather ahead, at a glance. A clean face, with room for what matters to you." current="product">
  <div class="page-shell">
    <header class="release-hero">
      <p class="eyebrow">Garmin watch face · {listing.version} Production release</p>
      <h1 class="sr-only">Burnished Sky Ahead</h1>
      <img class="release-banner" src={listing.hero} alt="Burnished Sky Ahead on a Forerunner 970, with a light sweeping across the title." width="1440" height="720" fetchpriority="high" />
      <div class="release-intro">
        <div>
          <h2>Time first, Weather ahead, at a glance.</h2>
          <p class="lede">A clean face, with room for what matters to you.</p>
          <div class="action-row">
            <a class="button primary" href={release.urls.connectIqStore}>Get it on Connect IQ</a>
            <a class="button" href="/burnished-sky-ahead/devices/">Features by watch</a>
          </div>
        </div>
        <div class="release-support">
          <p><strong>All features are free.</strong><br />Your support is welcome.</p>
          <p><a href="https://ko-fi.com/devjoe">Ko-fi</a> <span>(Anywhere)</span><br /><a href="https://garmin.devjoe.app/tw-tip">Taiwan support</a> <span>(Taiwan)</span></p>
        </div>
      </div>
    </header>
    <section class="release-gallery" aria-label="Explore the watch face">
      {listing.images.map(item => <img src={item.src} alt={item.alt} width="385" height="560" loading="lazy" />)}
    </section>
    <section class="section content-grid">
      <aside>Time, weather & what matters</aside>
      <div class="prose store-copy">
        {paragraphs.map(text => <p class:list={{ "touch-tip": text.startsWith("Tip:"), "feature-summary": text.startsWith("•") }}>{text.replace(/^• /, "")}</p>)}
        <div class="action-row">
          <a class="button" href="/burnished-sky-ahead/support/">Support and FAQ</a>
          <a class="button" href="/burnished-sky-ahead/forecast/">Read the forecast</a>
          <a class="button" href="/changelog/">What’s new</a>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>
