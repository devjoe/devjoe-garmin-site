---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import release from "../../../data/release.json";
import listing from "../../../data/store-listing.json";
---
<SiteLayout title="Updates — Burnished Sky Ahead" description="What’s new in Burnished Sky Ahead." current="roadmap">
  <div class="page-shell">
    <header class="page-intro">
      <p class="eyebrow">Burnished Sky Ahead · {listing.version}</p>
      <h1>What’s new.</h1>
      <p class="lede">All features are free. Your support is welcome.</p>
    </header>
    <section class="content-grid">
      <aside>Released for everyone</aside>
      <div class="prose">
        {listing.whatsNew.map(item => <section><h2>{item.title}</h2>{item.paragraphs.map(text => <p>{text}</p>)}</section>)}
        <div class="action-row">
          <a class="button primary" href={release.urls.connectIqStore}>Get it on Connect IQ</a>
          <a class="button" href="/changelog/">Full release history</a>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>
