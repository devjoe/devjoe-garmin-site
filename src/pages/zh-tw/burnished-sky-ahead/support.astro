---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import release from "../../../data/release.json";

const ecpayDonationUrl = "https://p.ecpay.com.tw/A6ABCC0";
---

<SiteLayout
  title="台灣支持頁 — Burnished Sky Ahead"
  description="Burnished Sky Ahead 是免費的 Garmin Connect IQ 錶面。喜歡的話，歡迎支持我繼續開發、測試與維護。"
  socialImage="/images/burnished-sky-ahead/hero-1440x720.png"
  socialImageAlt="Burnished Sky Ahead 錶面與顯示時間、天氣資訊的 Garmin 手錶產品主視覺"
  current="support"
  lang="zh-Hant-TW"
  showGarminDisclaimer={false}
>
  <div class="page-shell">
    <section class="taiwan-support-hero" aria-labelledby="taiwan-support-title">
      <div class="taiwan-support-copy">
        <h1 id="taiwan-support-title" class="taiwan-support-title">
          <span class="taiwan-support-title-kicker">Free Garmin Watch Face：</span>
          <span class="taiwan-support-title-name">Burnished Sky Ahead</span>
        </h1>
        <p class="taiwan-support-lede">
          喜歡的話，請支持我繼續開發、測試與維護。<img
            class="taiwan-support-avatar"
            src="/images/burnished-sky-ahead/ko-fi-momitu.webp"
            alt="Momitu 坐在電腦前的 Ko-fi 頭像"
            width="210"
            height="210"
            loading="lazy"
          />
        </p>
        <a class="taiwan-store-link" href={release.urls.connectIqStore}>
          Garmin Connect IQ 免費下載 <span aria-hidden="true">↗</span>
        </a>

        <section class="taiwan-support-pricing" aria-label="支持選項">
          <dl class="taiwan-support-amounts">
            <div class="taiwan-support-amount">
              <dt>真心感謝！</dt>
              <dd>NT$149</dd>
            </div>
            <div class="taiwan-support-amount">
              <dt>下跪道謝！！</dt>
              <dd>NT$249</dd>
            </div>
            <div class="taiwan-support-amount">
              <dt>無限感謝！！！<span class="taiwan-support-tier-note">（Token 自由啦～）</span></dt>
              <dd>NT$599</dd>
            </div>
          </dl>
        </section>

        <div class="taiwan-ecpay-cta">
          <div class="taiwan-ecpay-copy">
            <p class="eyebrow">綠界付款</p>
            <p>贊助若有附留言，每一則都會用心閱讀。</p>
          </div>
          <a
            class="button primary taiwan-ecpay-button"
            href={ecpayDonationUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            前往綠界贊助 <span aria-hidden="true">↗</span>
          </a>
        </div>

        <p class="taiwan-language-link"><a href="/burnished-sky-ahead/support/">English support page</a></p>
      </div>

      <figure class="taiwan-support-art">
        <img
          src="/images/burnished-sky-ahead/hero-1440x720.png"
          alt="Burnished Sky Ahead 顯示時間與天氣資訊的 Garmin 錶面"
          width="1440"
          height="720"
          fetchpriority="high"
        />
      </figure>
    </section>

    <section class="content-grid taiwan-support-details" aria-label="更多資訊">
      <aside>更多資訊</aside>
      <div class="prose">
        <h2>提醒</h2>
        <p>
          手錶功能完全免費，支持不會解鎖額外功能或內容，也不保證軟體更新時程。
        </p>

        <h2>有問題？</h2>
        <p>
          歡迎寫信給我：<a href={"mailto:" + release.urls.supportEmail}>{release.urls.supportEmail}</a>
        </p>

        <div class="action-row">
          <a class="button" href={release.support.url}>海外支持：Ko-fi</a>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>
